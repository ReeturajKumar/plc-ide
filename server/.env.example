# Tag database (PostgreSQL). Copy this file to .env and fill in the password.
MYPLC_DB_HOST=localhost
MYPLC_DB_PORT=5432
MYPLC_DB_NAME=webscada_preview
MYPLC_DB_USER=postgres
MYPLC_DB_PASSWORD=

MYPLC_SCADA_URL=

# Live tag values straight from the Modbus TCP devices set up in the tag database
# (modbus_tcp_devices: ip/port/unit; modbus_tags: register type, format, address). 1 = on.
# Used when MYPLC_SCADA_URL is empty.
MYPLC_MODBUS=

# PLC scan interval in ms (1-10000) when the project gives none. Default 100.
MYPLC_SCAN_MS=
