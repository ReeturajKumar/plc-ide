# Tag database (PostgreSQL). Copy this file to .env and fill in the password.
MYPLC_DB_HOST=localhost
MYPLC_DB_PORT=5432
MYPLC_DB_NAME=webscada_preview
MYPLC_DB_USER=postgres
MYPLC_DB_PASSWORD=

# Live tag values from the SCADA's WebSocket. mock-scada/ stands in for it while testing;
# put the real system's address here later. Empty: values come from data_log instead.
MYPLC_SCADA_URL=ws://127.0.0.1:6000
