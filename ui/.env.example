# Where the PLC backend (myplc-runtime --listen) runs. Copy this file to .env and edit.
# Same machine: ws://127.0.0.1:5020   On-prem server: ws://<server-ip>:5020
VITE_RUNTIME_URL=ws://127.0.0.1:5020

# Only if the backend was started with --token (or MYPLC_TOKEN). Letters and digits.
VITE_RUNTIME_TOKEN=
